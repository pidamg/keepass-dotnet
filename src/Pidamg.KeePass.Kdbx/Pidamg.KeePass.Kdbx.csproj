<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Pidamg.KeePass.Kdbx</PackageId>
    <RootNamespace>Pidamg.KeePass</RootNamespace>
    <IsPackable>true</IsPackable>
    <Version>0.0.0-dev</Version>
    <Description>Bibliothèque .NET pour lire et écrire les fichiers de mots de passe KeePass (.kdbx).</Description>
    <PackageTags>keepass;kdbx;password;vault</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pidamg.KeePass.Kdbx.Tests" />
  </ItemGroup>
</Project>
