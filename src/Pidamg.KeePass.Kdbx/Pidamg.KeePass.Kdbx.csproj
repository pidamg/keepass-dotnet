<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Pidamg.KeePass.Kdbx</PackageId>
    <Title>Pidamg.KeePass.Kdbx</Title>
    <RootNamespace>Pidamg.KeePass</RootNamespace>
    <IsPackable>true</IsPackable>
    <Version>0.0.0-dev</Version>
    <Description>A .NET library for reading, creating, and writing KeePass KDBX password databases.</Description>
    <PackageTags>keepass;kdbx;password-manager;password-vault;cryptography;security</PackageTags>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/package-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pidamg.KeePass.Kdbx.Tests" />
  </ItemGroup>
</Project>
